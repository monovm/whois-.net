<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NeutralLanguage>en</NeutralLanguage>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      Globalization-invariant mode is deliberately left off: IdnMapping is what converts
      internationalised names to punycode, and it needs ICU to do it.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>MonoVM</Authors>
    <Company>MonoVM</Company>
    <Copyright>Copyright (c) MonoVM</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/monovm/whois-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/monovm/whois-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
